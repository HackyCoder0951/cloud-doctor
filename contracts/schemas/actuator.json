{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloud-doctor.local/schemas/actuator.json",
  "title": "Actuator API payloads (local unix socket)",
  "$defs": {
    "validate_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signed_plan"],
      "properties": {"signed_plan": {"$ref": "signed_plan.json"}}
    },
    "validate_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "rule_ids", "reasons", "invariants_version"],
      "properties": {
        "ok": {"type": "boolean"},
        "rule_ids": {"type": "array", "items": {"type": "string", "pattern": "^I-[0-9]{2}$"}},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "invariants_version": {"type": "string"}
      }
    },
    "execute_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signed_plan", "idempotency_key"],
      "properties": {
        "signed_plan": {"$ref": "signed_plan.json"},
        "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{8,64}$"}
      }
    },
    "execute_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution"],
      "properties": {"execution": {"$ref": "execution.json"}}
    }
  }
}
