{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloud-doctor.local/schemas/evidence.json",
  "title": "Evidence record",
  "description": "One stored observation with provenance. Log text inside payload is untrusted and must never be treated as instructions or rendered as HTML. NUL characters must be stripped before storage. payload_hash is computed over the canonical JSON serialisation (sorted keys, no insignificant whitespace, UTF-8) BEFORE insert and is never recomputed from stored JSONB.",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "incident_id", "source", "type", "service", "observed_at", "collected_at", "query", "status", "payload", "payload_hash", "untrusted"],
  "properties": {
    "evidence_id": {"$ref": "common.json#/$defs/evidence_id"},
    "incident_id": {"$ref": "common.json#/$defs/incident_id"},
    "source": {"enum": ["prometheus", "loki", "container_event", "health_probe", "synthetic_probe", "deploy_event", "alert"]},
    "type": {"enum": ["metric", "log", "event", "probe"]},
    "service": {"$ref": "common.json#/$defs/service_name"},
    "observed_at": {"$ref": "common.json#/$defs/timestamp"},
    "collected_at": {"$ref": "common.json#/$defs/timestamp"},
    "query": {"type": "string", "maxLength": 2000},
    "status": {"$ref": "common.json#/$defs/evidence_status"},
    "missing_signal_state": {"$ref": "common.json#/$defs/missing_signal_state"},
    "summary": {"type": "string", "maxLength": 500},
    "payload": {"type": "object"},
    "payload_hash": {"$ref": "common.json#/$defs/sha256"},
    "untrusted": {"type": "boolean"}
  }
}
