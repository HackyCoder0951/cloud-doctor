{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloud-doctor.local/schemas/verification.json",
  "title": "Recovery verification result",
  "description": "Recovery requires every check to pass over the stability window. A check whose result cannot be established is passed=null and forces verdict 'unverifiable' (fail closed).",
  "type": "object",
  "additionalProperties": false,
  "required": ["incident_id", "execution_id", "verdict", "window_start", "window_end", "checks"],
  "properties": {
    "incident_id": {"$ref": "common.json#/$defs/incident_id"},
    "execution_id": {"$ref": "common.json#/$defs/execution_id"},
    "verdict": {"$ref": "common.json#/$defs/verdict"},
    "window_start": {"$ref": "common.json#/$defs/timestamp"},
    "window_end": {"$ref": "common.json#/$defs/timestamp"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passed"],
        "properties": {
          "name": {"enum": ["readiness", "dependencies", "error_sli", "latency_sli", "synthetic_transaction", "no_regression", "telemetry_fresh"]},
          "passed": {"type": ["boolean", "null"]},
          "baseline": {"type": "number"},
          "pre_action": {"type": "number"},
          "post_action": {"type": "number"},
          "detail": {"type": "string", "maxLength": 300},
          "evidence": {"type": "array", "items": {"$ref": "common.json#/$defs/evidence_id"}}
        }
      }
    }
  }
}
