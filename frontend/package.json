{
  "name": "cloud-doctor-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud Doctor operator dashboard (Stream D). Next.js static export; all auth/authz is enforced by the Python API.",
  "engines": { "node": ">=20.9.0" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../contracts/openapi.yaml -o src/api/schema.d.ts",
    "check:api": "node scripts/check-api-fresh.mjs",
    "mock": "node mock/server.mjs",
    "check:nginx": "node scripts/check-nginx.mjs",
    "ci": "npm run check:api && npm run typecheck && npm test && npm run build && npm run check:nginx"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "yaml": "2.9.0"
  }
}
