{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloud-doctor.local/harness/scenario.json",
  "title": "Harness scenario configuration (harness-owned, not a frozen contract)",
  "description": "One experiment. Everything under ground_truth, fault, decoy and accepted_remediation is HARNESS-ONLY and must never be sent to the Cloud Doctor API. Numbers in timing/abort/steady_state are provisional design values, not measurements.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "status", "title", "objective", "design_doc", "is_control", "targets", "affected_services", "fault", "timing", "abort", "steady_state", "ground_truth", "accepted_remediation", "max_attempts", "recoverability", "variants", "repetitions"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^EXP-[0-9]{2}$"},
    "status": {"enum": ["designed", "draft"], "description": "draft = candidate not yet designed in detail (EXP-11, EXP-12); the runner refuses drafts unless explicitly allowed."},
    "draft_note": {"type": "string", "maxLength": 600},
    "title": {"type": "string", "minLength": 3, "maxLength": 120},
    "objective": {"type": "string", "minLength": 10, "maxLength": 800},
    "design_doc": {"type": "string", "pattern": "^docs/11-experiments/[a-z0-9-]+\\.md$"},
    "is_control": {"type": "boolean", "description": "A control scenario injects nothing (fault.type none)."},
    "targets": {"type": "array", "items": {"$ref": "#/$defs/service"}, "uniqueItems": true, "description": "Catalog services the injector touches (blast radius of the injection itself)."},
    "affected_services": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/service"}, "uniqueItems": true, "description": "Services an incident for this fault is expected to list; used only to match incidents to the injected fault."},
    "fault": {"$ref": "#/$defs/fault"},
    "decoy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fault", "lead_seconds"],
      "properties": {
        "fault": {"$ref": "#/$defs/fault"},
        "lead_seconds": {"type": "integer", "minimum": 1, "maximum": 600, "description": "Decoy is applied this long before the real fault."}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_seconds", "baseline_timeout_seconds", "max_duration_seconds", "detection_deadline_seconds", "poll_seconds", "settle_seconds"],
      "properties": {
        "baseline_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "baseline_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 7200},
        "max_duration_seconds": {"type": "integer", "minimum": 1, "maximum": 7200, "description": "Duration cap after injection (also the control-run duration)."},
        "detection_deadline_seconds": {"type": "integer", "minimum": 1, "maximum": 7200},
        "poll_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 60},
        "settle_seconds": {"type": "integer", "minimum": 0, "maximum": 600},
        "inject_jitter_seconds": {"type": "number", "minimum": 0, "maximum": 60, "description": "Seeded random delay before injection."}
      }
    },
    "abort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_unhealthy_services", "max_action_services", "max_executions"],
      "properties": {
        "max_unhealthy_services": {"type": "integer", "minimum": 1, "maximum": 20, "description": "Blast-radius cap: abort when more services than this are degraded/unhealthy or breach steady state."},
        "max_action_services": {"type": "integer", "minimum": 0, "maximum": 20, "description": "Abort when executed actions have targeted more distinct services than this."},
        "max_executions": {"type": "integer", "minimum": 0, "maximum": 50, "description": "Abort when more actions than this were executed."}
      }
    },
    "steady_state": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "sli", "op", "threshold"],
        "properties": {
          "service": {"$ref": "#/$defs/service"},
          "sli": {"enum": ["error_ratio", "latency_p95_seconds", "throughput_rps", "queue_depth", "availability"]},
          "op": {"enum": ["<=", ">="]},
          "threshold": {"type": "number", "minimum": 0}
        }
      }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cause_equivalence_class", "cause_service", "decoy_causes"],
      "properties": {
        "cause_equivalence_class": {"type": "array", "items": {"$ref": "#/$defs/cause_id"}, "uniqueItems": true, "description": "Acceptable cause_ids; empty only for control scenarios."},
        "cause_service": {"anyOf": [{"$ref": "#/$defs/service"}, {"type": "null"}]},
        "decoy_causes": {"type": "array", "items": {"$ref": "#/$defs/cause_id"}, "uniqueItems": true}
      }
    },
    "accepted_remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "actions"],
      "properties": {
        "outcome": {"enum": ["mitigated", "escalated", "either", "no_action"]},
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action_id", "service"],
            "properties": {
              "action_id": {"enum": ["restart_service", "rollback_service", "scale_service", "clear_cache", "isolate_dependency", "escalate"]},
              "service": {"$ref": "#/$defs/service"}
            }
          }
        }
      }
    },
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10, "description": "Configured per incident+service+action attempt budget (invariant I-04 default 2); used for loop counting."},
    "recoverability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_signals"],
      "properties": {
        "required_signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "source", "visibility", "required", "supports", "description"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,60}$"},
              "source": {"enum": ["metric", "log", "event", "topology", "status"]},
              "service": {"$ref": "#/$defs/service"},
              "name": {"type": "string", "maxLength": 80},
              "to": {"$ref": "#/$defs/service"},
              "visibility": {"enum": ["api", "backend_internal", "unavailable_in_mvp"], "description": "api = readable through the public API; backend_internal = collected by the backend from a scrape target/log source but not readable by the harness (unverified); unavailable_in_mvp = known not collected."},
              "required": {"type": "boolean"},
              "supports": {"enum": ["cause", "action"]},
              "description": {"type": "string", "maxLength": 300}
            }
          }
        }
      }
    },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["llm", "log_noise"],
      "properties": {
        "llm": {"type": "array", "items": {"enum": ["off", "on"]}, "minItems": 1, "uniqueItems": true, "description": "METADATA ONLY. The harness records the flag; it never calls or depends on an LLM."},
        "log_noise": {"type": "array", "items": {"enum": ["off", "on"]}, "minItems": 1, "uniqueItems": true, "description": "METADATA ONLY in this version (log-noise injection is not implemented)."}
      }
    },
    "repetitions": {"type": "integer", "minimum": 1, "maximum": 100, "description": "Provisional; the framework sets N after observing variance."}
  },
  "$defs": {
    "service": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$"},
    "cause_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,60}$"},
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target", "params", "persistent"],
      "properties": {
        "type": {"enum": ["none", "container_stop", "container_kill", "cpu_hog", "memory_hog", "bad_deployment", "benign_deployment", "latency_toxic", "proxy_disable", "connection_hog", "disk_fill", "telemetry_outage"]},
        "target": {"anyOf": [{"$ref": "#/$defs/service"}, {"type": "null"}]},
        "params": {"type": "object"},
        "persistent": {"type": "boolean", "description": "Re-apply the fault after Cloud Doctor restarts the container (container_stop/container_kill only)."},
        "max_reapplications": {"type": "integer", "minimum": 1, "maximum": 50}
      }
    }
  }
}
